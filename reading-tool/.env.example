ANTHROPIC_API_KEY=your_key_here

# Supabase anon key is safe to expose client-side (VITE_ prefix) -- access is
# controlled by Row Level Security policies, not by keeping this secret.
VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Slack Incoming Webhook that in-app feedback is posted to (api/feedback.js).
# Optional: leave unset and the rest of the app runs fine, but sending
# feedback will fail.
SLACK_FEEDBACK_WEBHOOK_URL=your_webhook_url_here
